*.sbx

# HidroFlow temporales
HidroFlow - copia.jsx

# Respaldos internos de Git - no versionar
.git_BACKUP*/
**/.git_BACKUP*/
**/.git_BACKUP_APP*/

# Ruido histórico dentro de la app - no versionar
01_APP/HIDROFLOW/*.docx
01_APP/HIDROFLOW/src/*.BACKUP.*
01_APP/HIDROFLOW/src/HidroFlow*.txt
01_APP/HIDROFLOW/src/**/*BACKUP*
