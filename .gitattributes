# =========================================
# HidroFlow - Git Attributes
# Control profesional de finales de línea
# =========================================

# Texto general en LF para estabilidad multiplataforma
* text=auto eol=lf

# Scripts Windows en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.tbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.7z binary
*.rar binary

# Datos GIS/binarios frecuentes
*.tif binary
*.tiff binary
*.img binary
*.gdb binary
*.shp binary
*.shx binary
*.dbf binary
